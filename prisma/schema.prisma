// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Application {
  id                 String   @id @default(cuid())
  type               String   // "LEAD" or "TEAM"
  name               String
  collegeEmail       String
  rollNumber         String
  yearOfStudy        String
  phoneNumber        String
  positionAppliedFor String
  portfolioLink      String?
  whyJoin            String?
  status             String   @default("PENDING") // PENDING, REVIEWED, ACCEPTED, REJECTED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([collegeEmail, positionAppliedFor, type])
  @@index([status])
}

model Magazine {
  id          String   @id @default(cuid())
  title       String
  volume      String
  year        String
  description String?
  pdfUrl      String
  coverImage  String?
  createdAt   DateTime @default(now())
}

model InstagramPost {
  id        String   @id @default(cuid())
  imageUrl  String
  postUrl   String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  desk      String
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
