# Environment Variables
# Copy this file to `.env` and fill in the values.

# ── Database ────────────────────────────────────────────────
# SQLite (dev). For production, switch to PostgreSQL:
# DATABASE_URL="postgresql://user:pass@host:5432/talkies?sslmode=require"
DATABASE_URL="file:./dev.db"

# ── Admin ───────────────────────────────────────────────────
# Password for the /admin/magazines panel.
# REQUIRED — the API will reject requests if this is not set.
ADMIN_PASSWORD="change-me-in-production"
